{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Configuração Multiagente v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "repository",
    "workspace"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentDirectory"],
      "properties": {
        "parentDirectory": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "coordination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "default": "main"
        },
        "codex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "default": "feature/codex"
        },
        "claude": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "default": "feature/claude"
        },
        "maintenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "default": "chore/manutencao"
        }
      }
    }
  }
}
